SKIP_PREFLIGHT_CHECK=true
#REACT_APP_VALHALLA_URL=https://valhalla1.openstreetmap.de
#REACT_APP_VALHALLA_URL=http://valhalla-svc:8002
#REACT_APP_VALHALLA_URL=http://localhost:8002
REACT_APP_VALHALLA_URL=http://+process.env.VALHALLA_SVC_HOST+/valhalla-svc





#REACT_APP_NOMINATIM_URL=https://nominatim.openstreetmap.org
#REACT_APP_NOMINATIM_URL=http://nominatim-svc:8080
#REACT_APP_NOMINATIM_URL=http://localhost:8080
REACT_APP_NOMINATIM_URL=http://+process.env.NOMINATIM_SVC_HOST+/nominatim-svc

#REACT_APP_TILE_SERVER_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
#REACT_APP_TILE_SERVER_URL="http://wms-tiler-svc:6789/openstreetmap-carto/tile/{z}/{x}/{y}.png"
#REACT_APP_TILE_SERVER_URL="http://localhost:6789/openstreetmap-carto/tile/{z}/{x}/{y}.png"
REACT_APP_TILE_SERVER_URL=http://+process.env.WMS_TILER_HOST+/openstreetmap-carto/tile/{z}/{x}/{y}.png

REACT_APP_CENTER_COORDS="52.51831,13.393707"

# uncomment this variable to set boundaries on the leaflet map
#                       southwest corner, northeast corner
REACT_APP_MAX_BOUNDS="-90,-1e7,90,1e7"
